{
  "name": "aaru-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jsdom": "30.1.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.4",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@sentry/browser": "11.8.0"
  }
}
