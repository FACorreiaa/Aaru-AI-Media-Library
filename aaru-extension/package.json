{
  "name": "aaru-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "eslint": "^9.20.0",
    "jsdom": "30.1.1",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vitest": "^5.0.4",
    "wxt": "0.21.4"
  }
}
