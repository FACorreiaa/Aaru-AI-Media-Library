#include "Base.xcconfig"

// Local development: the Beta identity (no extra App ID to register) against a
// server on this machine (`cd aaru-server && swift run`).
APP_BUNDLE_ID = com.fernandocorreia.aaru.beta
APP_DISPLAY_NAME = Aaru Dev
APP_ICON_NAME = AppIconBeta
API_BASE_URL = http:/$()/localhost:8080

// APNs gateway this build registers with: Xcode runs use development (sandbox); TestFlight
// and the App Store use production.
APS_ENVIRONMENT = development
// Sign in with Google: the iOS OAuth client for this bundle id (public). Empty hides the button.
GOOGLE_CLIENT_ID = 1021071971791-8oi7eebqo5ltecmboo1ngs6krtb21ff1.apps.googleusercontent.com
