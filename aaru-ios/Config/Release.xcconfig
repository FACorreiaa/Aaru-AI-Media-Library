#include "Base.xcconfig"

// App Store.
APP_BUNDLE_ID = com.fernandocorreia.aaru
APP_DISPLAY_NAME = Aaru
APP_ICON_NAME = AppIcon
// Placeholder until the domain exists (BACKLOG REL-005 OPEN).
API_BASE_URL = https:/$()/api.aaru.example

// APNs gateway this build registers with: Xcode runs use development (sandbox); TestFlight
// and the App Store use production.
APS_ENVIRONMENT = production
// Sign in with Google: the iOS OAuth client for this bundle id (public). Empty hides the button.
GOOGLE_CLIENT_ID = 1021071971791-me5t60upgnaqdcfa04l2bgca1dhkteuf.apps.googleusercontent.com
