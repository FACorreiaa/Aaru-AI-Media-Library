# Aaru release lanes (BACKLOG REL-004). One multiplatform target, shipped to
# iPhone/iPad and to the Mac: every lane runs once per entry of PLATFORMS.
#
#   beta         Beta config (bundle id + .beta) -> TestFlight, internal testers
#   release      Release config -> App Store, phased, submitted for review
#   hotfix       Release config -> App Store, not phased
#   metadata     store copy from fastlane/metadata -> App Store Connect, no build
#   seed_signing turns on the App IDs' capabilities and reissues Aaru's match profiles
#                (run before the first beta and after any entitlement change). It is
#                the only lane that may create a certificate: the Mac App Store's
#                Mac Installer Distribution certificate, the first time it runs.
#
# Both Beta and Release talk to the production API; beta is client-side only.

default_platform(:ios)

PROJECT = "Aaru.xcodeproj"
TEAM_ID = "84X9WYBF36"
BUNDLE_ID = "com.fernandocorreia.aaru"
BETA_BUNDLE_ID = "com.fernandocorreia.aaru.beta"
SCHEMES = { "Beta" => "Aaru Beta", "Release" => "Aaru" }.freeze
PLATFORMS = %w[ios macos].freeze

# deliver's name for a platform.
def store_platform(platform)
  platform == "macos" ? "osx" : "ios"
end

# The Mac App Store takes a signed .pkg, so a Mac build needs the installer certificate too.
def installer_cert_types(platform)
  platform == "macos" ? ["mac_installer_distribution"] : nil
end

# Who App Review can reach, the account it signs in with, and the notes it reads. The
# contact and the demo account come from the environment (GitHub secrets REVIEW_*), never
# from a file here: the demo password signs in to production. Nil while they are unset, so
# a lane still runs and the review information is filled in App Store Connect instead.
def review_information
  keys = %w[REVIEW_FIRST_NAME REVIEW_LAST_NAME REVIEW_EMAIL REVIEW_PHONE REVIEW_DEMO_USER REVIEW_DEMO_PASSWORD]
  return nil if keys.any? { |key| ENV[key].to_s.empty? }

  {
    first_name: ENV["REVIEW_FIRST_NAME"],
    last_name: ENV["REVIEW_LAST_NAME"],
    email_address: ENV["REVIEW_EMAIL"],
    phone_number: ENV["REVIEW_PHONE"],
    demo_user: ENV["REVIEW_DEMO_USER"],
    demo_password: ENV["REVIEW_DEMO_PASSWORD"],
    notes: File.read(File.join(__dir__, "metadata/review_information/notes.txt"))
  }
end

platform :ios do
  desc "Build the Beta configuration and upload it to TestFlight (internal)"
  lane :beta do
    api_key = asc_api_key
    setup_ci if is_ci
    bump_build_number(api_key: api_key, bundle_id: BETA_BUNDLE_ID)
    PLATFORMS.each do |platform|
      # Read-only in CI: the team is at its certificate limit, so a lane that
      # may write would try to mint a certificate whenever match sees a
      # problem. Profiles come from `seed_signing`.
      ship(platform: platform, config: "Beta", bundle_id: BETA_BUNDLE_ID, api_key: api_key)
    end
  end

  desc "Release to the App Store (phased). Usage: fastlane release [version:1.1]"
  lane :release do |options|
    store_release(options.merge(phased: true))
  end

  desc "Hotfix release: no phased rollout. Usage: fastlane hotfix [version:1.0.1]"
  lane :hotfix do |options|
    store_release(options.merge(phased: false))
  end

  desc "Upload the store copy in fastlane/metadata, without a build or a review submission"
  lane :metadata do
    api_key = asc_api_key
    PLATFORMS.each do |platform|
      upload_to_app_store(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        platform: store_platform(platform),
        skip_binary_upload: true,
        submit_for_review: false,
        force: true,
        skip_screenshots: !File.directory?("screenshots"),
        precheck_include_in_app_purchases: false,
        app_review_information: review_information
      )
    end
  end

  desc "Create App Store profiles for every Aaru id and push them to the match repo"
  lane :seed_signing do
    api_key = asc_api_key
    setup_ci if is_ci
    enable_capabilities
    PLATFORMS.each do |platform|
      # force: a capability turned on since the last run is only in a newly issued profile.
      # The iOS distribution certificate is never minted here (the team is at its limit and
      # the repo holds it). The Mac App Store needs one more, a Mac Installer Distribution
      # certificate to sign the .pkg: match creates it on the first run and reuses it after.
      match(
        type: "appstore",
        platform: platform,
        additional_cert_types: installer_cert_types(platform),
        readonly: false,
        force: true,
        api_key: api_key
      )
    end
  end

  # ---- helpers ----

  private_lane :store_release do |options|
    api_key = asc_api_key
    setup_ci if is_ci
    increment_version_number(version_number: options[:version], xcodeproj: PROJECT) if options[:version]
    bump_build_number(api_key: api_key, bundle_id: BUNDLE_ID)

    PLATFORMS.each do |platform|
      ship(platform: platform, config: "Release", bundle_id: BUNDLE_ID, api_key: api_key, testflight: false)
      upload_to_app_store(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        platform: store_platform(platform),
        pkg: platform == "macos" ? lane_context[SharedValues::PKG_OUTPUT_PATH] : nil,
        submit_for_review: true,
        automatic_release: true,
        phased_release: options[:phased],
        precheck_include_in_app_purchases: false,
        force: true,
        skip_metadata: !File.directory?("metadata"),
        # Screenshots are added in App Store Connect until screenshots/ exists here.
        skip_screenshots: !File.directory?("screenshots"),
        app_review_information: review_information,
        # The app uses only the system's own encryption (HTTPS), as its Info.plist says
        # (ITSAppUsesNonExemptEncryption = NO), and shows no ads.
        submission_information: {
          export_compliance_uses_encryption: false,
          add_id_info_uses_idfa: false
        }
      )
    end
  end

  # Signs, archives, and (for TestFlight) uploads one platform's build.
  private_lane :ship do |options|
    platform = options[:platform]
    config = options[:config]
    bundle_id = options[:bundle_id]
    api_key = options[:api_key]
    macos = platform == "macos"

    match(
      type: "appstore",
      platform: platform,
      additional_cert_types: installer_cert_types(platform),
      readonly: options.fetch(:readonly, is_ci),
      api_key: api_key
    )
    pin_profiles(platform: platform, config: config, bundle_id: bundle_id)

    build_app(
      project: PROJECT,
      scheme: SCHEMES.fetch(config),
      configuration: config,
      destination: macos ? "generic/platform=macOS" : "generic/platform=iOS",
      export_method: "app-store",
      installer_cert_name: macos ? "3rd Party Mac Developer Installer" : nil,
      output_directory: "fastlane/build/#{platform}"
    )
    upload_dsyms

    next if options[:testflight] == false

    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      app_platform: macos ? "osx" : "ios",
      pkg: macos ? lane_context[SharedValues::PKG_OUTPUT_PATH] : nil,
      skip_waiting_for_build_processing: macos, # wait once, on the iOS upload
      distribute_external: false
    )
  end

  # Crash symbols for Sentry (aaru-ios), only when CI has SENTRY_AUTH_TOKEN. A failed upload
  # never fails the build: the crash still arrives, just unsymbolicated.
  private_lane :upload_dsyms do
    next if ENV["SENTRY_AUTH_TOKEN"].to_s.empty?

    begin
      sentry_debug_files_upload(
        auth_token: ENV["SENTRY_AUTH_TOKEN"],
        org_slug: ENV.fetch("SENTRY_ORG", "fernando-lda"),
        project_slug: ENV.fetch("SENTRY_PROJECT", "aaru-ios"),
        path: lane_context[SharedValues::DSYM_OUTPUT_PATH]
      )
    rescue StandardError => e
      UI.important("Sentry dSYM upload failed: #{e.message}")
    end
  end

  # Local development uses automatic signing; archives pin the match profile for
  # the app and for the widget extension (bundle id + ".widgets"), per platform.
  private_lane :pin_profiles do |options|
    bundle_id = options[:bundle_id]
    suffix = options[:platform] == "macos" ? " macos" : ""
    { "Aaru" => bundle_id, "AaruWidgetsExtension" => "#{bundle_id}.widgets" }.each do |target, id|
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{id}#{suffix}",
        targets: [target],
        build_configurations: [options[:config]]
      )
    end
  end

  # Capabilities the entitlements ask for that App IDs do not grant on their own. Associated
  # Domains (SOC-002): the apps claim aaruapp.com/i/* so invite links open them. Idempotent.
  private_lane :enable_capabilities do
    associated = Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS
    [BUNDLE_ID, BETA_BUNDLE_ID].each do |id|
      bundle = Spaceship::ConnectAPI::BundleId.find(id) || UI.user_error!("No App ID #{id}")
      next if bundle.get_capabilities.any? { |capability| capability.capability_type == associated }

      bundle.create_capability(associated)
      UI.success("Associated Domains on for #{id}")
    end
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true
    )
  end

  # Builds share one number across iOS and macOS. A build uploaded minutes ago
  # is missing from get_builds until processing finishes, so take the highest of
  # the processed builds, TestFlight's latest, and the project's current number.
  private_lane :bump_build_number do |options|
    api_key = options[:api_key]
    bundle_id = options[:bundle_id]
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("Could not find #{bundle_id} on App Store Connect. Create the app record first.") unless app

    numbers = app.get_builds.map { |build| Integer(build.version, exception: false) }
    numbers << Integer(latest_testflight_build_number(api_key: api_key, app_identifier: bundle_id, initial_build_number: 0).to_s, exception: false)
    numbers << Integer(get_build_number(xcodeproj: PROJECT).to_s, exception: false)
    increment_build_number(build_number: (numbers.compact.max || 0) + 1, xcodeproj: PROJECT)
  end
end
