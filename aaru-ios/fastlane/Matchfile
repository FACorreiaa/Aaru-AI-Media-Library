# Aaru signs with Norviq's match storage: FinancePlanner/norviq-certificates.
# That repo holds the team's Apple Distribution certificate (4AQ4Q8XM7Z), so
# Aaru adds only its own App Store profiles next to Norviq's.
#
# Consequences:
#   - MATCH_PASSWORD is that repo's password (the same secret Norviq uses).
#   - MATCH_GIT_BASIC_AUTHORIZATION (base64 "x-access-token:<PAT>") needs a PAT
#     with Contents: Read AND Write on FinancePlanner/norviq-certificates: the
#     beta lane runs match in write mode, like Norviq's, so CI creates Aaru's
#     profiles the first time it signs. The App IDs and App Groups must exist
#     in the Developer portal first — match creates profiles, not App IDs.
#   - Revoking 4AQ4Q8XM7Z breaks Norviq AND Aaru signing.
git_url("https://github.com/FinancePlanner/norviq-certificates.git")
git_branch("main")
storage_mode("git")
type("appstore")
app_identifier([
  "com.fernandocorreia.aaru",
  "com.fernandocorreia.aaru.widgets",
  "com.fernandocorreia.aaru.beta",
  "com.fernandocorreia.aaru.beta.widgets"
])
team_id("84X9WYBF36")
