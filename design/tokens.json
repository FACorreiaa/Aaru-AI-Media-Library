{
  "$comment": "Aaru colour tokens, the one source for both clients (DESIGN.md \"Mindspace\"). Edit here, then run scripts/generate-tokens.mjs: it writes aaru-client/src/tokens.css and the Apple colour sets, and fails when a pair below drops under WCAG AA.",
  "colors": {
    "paper": {
      "note": "Page background. Warm ivory by day, reed-green charcoal by night; never pure black.",
      "light": "#f7f1e6",
      "dark": "#131b18",
      "apple": ["Paper"],
      "widget": ["Paper"]
    },
    "surface": {
      "note": "Raised: cards, panels, the active nav pill.",
      "light": "#eee6d6",
      "dark": "#1a2522",
      "apple": ["Surface"],
      "widget": ["Surface"]
    },
    "stone": {
      "note": "Sunken: wells, inset fields, empty art.",
      "light": "#e5dccb",
      "dark": "#0f1513",
      "apple": ["Stone"]
    },
    "ink": {
      "note": "Text and strong strokes.",
      "light": "#1c3336",
      "dark": "#ece4d3",
      "apple": ["Ink"],
      "widget": ["Ink"]
    },
    "muted": {
      "note": "Secondary text and metadata.",
      "light": "#4e6265",
      "dark": "#a2b1a9",
      "apple": ["Muted"],
      "widget": ["Muted"]
    },
    "accent": {
      "note": "Desaturated teal: primary actions, links, selection, focus.",
      "light": "#2c6a6e",
      "dark": "#86bcb1",
      "apple": ["AccentColor"],
      "widget": ["Brand"]
    },
    "on-accent": {
      "note": "Text on an accent fill.",
      "light": "#f7f1e6",
      "dark": "#131b18"
    },
    "gold": {
      "note": "Edge light only: hairlines, the next-up ring, selected dots. Never a filled surface.",
      "light": "#9c7836",
      "dark": "#c8a76a",
      "apple": ["Gold"],
      "widget": ["Gold"]
    },
    "agent": {
      "note": "Agent activity: the reed mark while Aaru works, plan-card accents. Not for body text.",
      "light": "#5f8070",
      "dark": "#9db7a2",
      "apple": ["Agent"]
    },
    "danger": {
      "note": "Errors and destructive actions.",
      "light": "#9c3a2d",
      "dark": "#e8a08f",
      "apple": ["Danger"]
    },
    "medallion": {
      "note": "The paper disc behind the mascot. Light in both appearances.",
      "light": "#fff9ed",
      "dark": "#f6eedd",
      "apple": ["Medallion"]
    },
    "line": {
      "note": "Hairlines and borders.",
      "light": { "of": "ink", "alpha": 0.12 },
      "dark": { "of": "ink", "alpha": 0.1 },
      "apple": ["Line"]
    },
    "line-strong": {
      "note": "Outlined controls, dividers that must be seen.",
      "light": { "of": "ink", "alpha": 0.22 },
      "dark": { "of": "ink", "alpha": 0.2 }
    }
  },
  "contrast": {
    "$comment": "[foreground, background, minimum ratio]. 4.5 for text, 3 for strokes, rings and indicators.",
    "pairs": [
      ["ink", "paper", 4.5],
      ["ink", "surface", 4.5],
      ["ink", "stone", 4.5],
      ["muted", "paper", 4.5],
      ["muted", "surface", 4.5],
      ["muted", "stone", 4.5],
      ["accent", "paper", 4.5],
      ["accent", "surface", 4.5],
      ["on-accent", "accent", 4.5],
      ["danger", "paper", 4.5],
      ["danger", "surface", 4.5],
      ["paper", "ink", 4.5],
      ["gold", "paper", 3],
      ["gold", "surface", 3],
      ["agent", "paper", 3],
      ["agent", "surface", 3],
      ["accent", "stone", 3]
    ]
  }
}
