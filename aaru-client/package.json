{
  "name": "aaru-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "eslint .",
    "check": "prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "api:generate": "npx --yes openapi-typescript@7.13.0 ../aaru-server/Sources/AppAPI/openapi.yaml -o src/lib/api/schema.d.ts && prettier --write src/lib/api/schema.d.ts",
    "cf:types": "wrangler types --strict-vars false",
    "size": "node scripts/size-budget.mjs",
    "tokens": "node ../scripts/generate-tokens.mjs",
    "tokens:check": "node ../scripts/generate-tokens.mjs --check"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@sentry/browser": "11.8.0",
    "@sentry/cloudflare": "11.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/solid-query": "5.104.2",
    "@tanstack/solid-router": "1.170.41",
    "@tanstack/solid-router-ssr-query": "1.167.3",
    "@tanstack/solid-start": "1.169.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "13.5.1",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "11.8.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-cli": "^1.133.21",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^5.0.4",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
