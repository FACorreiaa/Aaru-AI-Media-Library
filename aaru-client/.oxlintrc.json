{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Profile: bug finding. Every rule in the correctness, suspicious and perf
  // categories, plus the type-aware rules from pedantic that catch real
  // defects. Run as `oxlint --type-aware` (npm run lint). pedantic, style and
  // restriction stay off as whole categories: they are mostly taste.
  // The JSX selectors oxlint cannot express still run in ESLint
  // (eslint.config.js); formatting is Prettier's (npm run check).
  // No react plugin: this is SolidJS, and its rules misread Solid's JSX.
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": [
    "worker-configuration.d.ts",
    "src/routeTree.gen.ts",
    "src/lib/api/schema.d.ts",
    // Plain browser JavaScript served as-is, outside the TypeScript project.
    "public/sw.js",
    ".output/**",
    "dist/**"
  ],
  "overrides": [
    // `export {}` is what makes an ambient declaration file a module.
    {
      "files": ["**/*.d.ts"],
      "rules": { "unicorn/require-module-specifiers": "off" }
    },
    // The web UI rule (CLAUDE.md): every control comes from shadcn-solid in
    // components/ui, imported through its barrel. Inside components/ui the
    // components import each other freely (the override after this one).
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^~/components/ui/.+",
                "message": "Import UI from the barrel, '~/components/ui', not from its files."
              },
              {
                "regex": "^\\.{1,2}/(.*/)?(components/)?ui(/.*)?$",
                "message": "Import UI as '~/components/ui', not by a relative path."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    // Solid runs a component once, so a helper declared in one is made once,
    // not on every render, and it sits beside its one use by choice. A test's
    // helpers belong to their describe block for the same reason. In plain
    // modules the rule stays an error.
    {
      "files": ["src/**/*.tsx", "src/**/*.test.ts"],
      "rules": { "unicorn/consistent-function-scoping": "off" }
    },
    // A test says what a value is on purpose: a fixture with only the fields
    // the test reads, a plain object standing in for an Element. The rule is
    // for code that runs for users.
    {
      "files": ["src/**/*.test.ts"],
      "rules": { "typescript/no-unsafe-type-assertion": "off" }
    },
    // shadcn-solid's source as its registry ships it, kept identical to upstream
    // so a later copy diffs cleanly against it. These rules are off here
    // because only the vendored code breaks them and fixing it would fork it
    // (vendored shadcn-solid; kept identical to upstream). They stay errors
    // everywhere else. This override is last, so it wins over "rules" below.
    {
      "files": [
        "src/components/ui/**",
        "src/lib/cva.ts",
        "src/lib/call-handler.ts",
        "src/lib/combine-style.ts",
        "src/hooks/use-mobile.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "import/consistent-type-specifier-style": "off",
        "import/no-duplicates": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "no-shadow": "off",
        "import/no-named-as-default-member": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unsafe-function-type": "off",
        "eqeqeq": "off"
      }
    }
  ],
  "rules": {
    // Type-aware bug rules that oxlint files under pedantic.
    // `throw redirect()` is TanStack Router's control flow, not an error.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": "Redirect",
            "package": "@tanstack/router-core"
          }
        ]
      }
    ],
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/return-await": "error",
    "typescript/no-mixed-enums": "error",
    // Non-type-aware pedantic rules that catch defects rather than style.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "array-callback-return": "error",
    "no-self-compare": "error",
    "no-constructor-return": "error",

    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    // House rules carried over from @tanstack/eslint-config, which ESLint ran
    // before oxlint took over. They sit outside the three categories above.
    "no-case-declarations": "error",
    "no-fallthrough": "error",
    "no-regex-spaces": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": false, "ts-ignore": "allow-with-description" }
    ],
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports" }
    ],
    "typescript/method-signature-style": ["error", "property"],
    "typescript/no-inferrable-types": ["error", { "ignoreParameters": true }],
    "typescript/no-namespace": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/prefer-for-of": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-commonjs": "error",
    "import/no-duplicates": "error",
    "unicorn/prefer-node-protocol": "error",

    // More rules of this profile. They were the backlog of 2026-11-17, cleared
    // the same day. A rule the code breaks is fixed in the code, not turned
    // down to a warning here.
    "typescript/no-unsafe-type-assertion": "error",
    "unicorn/consistent-function-scoping": "error",
    "vitest/require-mock-type-parameters": "error",
    "typescript/consistent-return": "error",
    "unicorn/prefer-add-event-listener": "error",
    "no-shadow": "error",
    "promise/always-return": "error",
    "typescript/no-misused-spread": "error",
    "unicorn/prefer-set-has": "error",
    "typescript/unbound-method": "error",
    "typescript/no-base-to-string": "error",
    "no-new": "error",
    "unicorn/no-useless-spread": "error",
    "promise/no-callback-in-promise": "error",
    // `__root__` is TanStack Router's own key for the root route.
    "no-underscore-dangle": ["error", { "allow": ["__root__"] }],
    "typescript/no-implied-eval": "error",

    // Rules of the three categories that are wrong for this codebase, each
    // with its reason. Every hit was read before one was turned off.
    // Solid's compiler assigns `let el` from `ref={el}`, which the rule cannot
    // see. All 38 hits were refs.
    "no-unassigned-vars": "off",
    // The fix it asks for, toSorted(), is ES2023 and the project's lib is
    // ES2022. All 29 hits sorted an array made on the spot.
    "unicorn/no-array-sort": "off",
    // All 15 hits wait because the next step needs the last one's answer
    // (stream reads, paging, retries, writes in order).
    "no-await-in-loop": "off",
    // State here is immutable. A signal's rows are updated by mapping to a
    // copy of the one that changed; the in-place write this rule asks for
    // would change an object the old value still holds and tell Solid nothing.
    "oxc/no-map-spread": "off"
  }
}
