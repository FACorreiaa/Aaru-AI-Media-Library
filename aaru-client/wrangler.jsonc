{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production web (REL-006): deployed by manual dispatch of "Web Deploy".
  // Beta is `env.staging`, deployed on every merge to main. Both use the production API:
  // beta is client-side only, there is one backend.
  "name": "aaru-client",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/solid-start/server-entry",
  "workers_dev": true,
  "preview_urls": true,
  // Placeholder host until the domain exists (BACKLOG REL-005). Local dev overrides these in
  // `.dev.vars` (API_BASE_URL=http://localhost:8080).
  "vars": {
    "API_BASE_URL": "https://api.aaru.example",
    "CHANNEL": "production",
    // Sign in with Apple on the web needs a Services ID and a verified domain. Empty hides the button.
    "APPLE_SERVICES_ID": "",
    // Sign in with Google: the web OAuth client id (public). Its origin list must hold this
    // Worker's origin. Empty hides the button.
    "GOOGLE_CLIENT_ID": "1021071971791-bi4c3f06bokufcrd612t4m1homqd8l2k.apps.googleusercontent.com",
  },
  "env": {
    "staging": {
      "name": "aaru-client-staging",
      "vars": {
        "API_BASE_URL": "https://api.aaru.example",
        "CHANNEL": "beta",
        "APPLE_SERVICES_ID": "",
        "GOOGLE_CLIENT_ID": "1021071971791-bi4c3f06bokufcrd612t4m1homqd8l2k.apps.googleusercontent.com",
      },
    },
  },
}
