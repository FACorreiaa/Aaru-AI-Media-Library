{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production web (REL-006): deployed by manual dispatch of "Web Deploy".
  // Beta is `env.staging`, deployed on every merge to main. Both use the production API:
  // beta is client-side only, there is one backend.
  "name": "aaru-client",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  // Start's handler, wrapped for error reporting when SENTRY_DSN is set.
  "main": "src/server.ts",
  // Served only on aaruapp.com hosts: no second *.workers.dev origin to keep in Google's
  // origin list or to split sessions across. Custom domains get their DNS record and an edge
  // certificate from Cloudflare on deploy (the deploy token needs Workers Routes and DNS edit
  // on the aaruapp.com zone).
  "workers_dev": false,
  "preview_urls": true,
  // Local dev overrides these in `.dev.vars` (API_BASE_URL=http://localhost:8080).
  "vars": {
    "API_BASE_URL": "https://api.aaruapp.com",
    "CHANNEL": "production",
    // Sign in with Apple on the web needs a Services ID and a verified domain. Empty hides the button.
    "APPLE_SERVICES_ID": "",
    // Sign in with Google: the web OAuth client id (public). Its origin list must hold this
    // Worker's origin. Empty hides the button.
    "GOOGLE_CLIENT_ID": "1021071971791-bi4c3f06bokufcrd612t4m1homqd8l2k.apps.googleusercontent.com",
    // Error reporting (Sentry project aaru-web, EU). A DSN is public, not a secret. The Worker
    // reads it at runtime; the build bakes the same value into the browser chunk
    // (vite.config.ts). Empty turns reporting off in both.
    "SENTRY_DSN": "https://463ded6ff8bd2387b8a15f2710cc3b16@o4510766840872960.ingest.de.sentry.io/4512299384635472",
  },
  // www answers with a permanent redirect to the apex (src/start.ts).
  "routes": [
    { "pattern": "aaruapp.com", "custom_domain": true },
    { "pattern": "www.aaruapp.com", "custom_domain": true },
  ],
  "env": {
    "staging": {
      "name": "aaru-client-staging",
      "vars": {
        "API_BASE_URL": "https://api.aaruapp.com",
        "CHANNEL": "beta",
        "APPLE_SERVICES_ID": "",
        "GOOGLE_CLIENT_ID": "1021071971791-bi4c3f06bokufcrd612t4m1homqd8l2k.apps.googleusercontent.com",
        "SENTRY_DSN": "https://463ded6ff8bd2387b8a15f2710cc3b16@o4510766840872960.ingest.de.sentry.io/4512299384635472",
      },
      "routes": [{ "pattern": "beta.aaruapp.com", "custom_domain": true }],
    },
  },
}
