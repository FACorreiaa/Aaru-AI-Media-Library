#!/usr/bin/env bash
# pre-push: check formatting and lint before code leaves this machine.
# Runs swiftformat --lint (no rewrite) and swiftlint --strict in each Swift
# package with that package's own config — the same checks CI runs. Linting
# from the repo root would walk third-party sources under .build/.
# Periphery is intentionally excluded — it requires a full build and is
# too slow for a push gate. Run `scripts/lint.sh` on demand.
set -euo pipefail

export PATH="$PATH:/opt/homebrew/bin"

ROOT="$(git rev-parse --show-toplevel)"

fail_if_missing() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "pre-push: $1 not on PATH. Install via Homebrew: brew install $2" >&2
    exit 1
  fi
}

fail_if_missing swiftformat swiftformat
fail_if_missing swiftlint swiftlint

for pkg in aaru-core aaru-server aaru-ios; do
  [ -d "$ROOT/$pkg" ] || continue
  echo "pre-push: $pkg"
  (cd "$ROOT/$pkg" && swiftformat . --lint --quiet && swiftlint --strict --quiet)
done

echo "pre-push: ok"
